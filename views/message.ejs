<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= showonemessage.title %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image/png" href="/favicon.png?v=2">
</head>
<body>

  <h1><%= showonemessage.title %></h1>

  <p><%= showonemessage.description %></p>

  <% if (user && user.membership === true) { %>
    <p>Author: <%= showonemessage.username %></p>
    <p>Date: <%= showonemessage.created_at %></p>
  <% } else { %>
    <p>Author: Unknown</p>
  <% } %>

  <% if (user && user.admin === true) { %>
    <form action="/messages/<%= showonemessage.id %>/delete" method="POST">
      <button type="submit">Delete</button>
    </form>
  <% } %>

  <a href="/">Back</a>

</body>
</html>